# ============================================
# Servidor
# ============================================
PORT=8181
NODE_ENV=development

# ============================================
# Base de datos PostgreSQL (Supabase)
# ============================================
# Cadena de conexión que entrega Supabase
# (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:postgres@db.example.supabase.co:5432/postgres

# ============================================
# JWT
# ============================================
# JWT_SECRET=mi-secreto-seguro

# ============================================
# Almacenamiento de imágenes (Supabase Storage / Local)
# ============================================
# 'supabase' (por defecto) o 'local'
STORAGE_PROVIDER=supabase
# URL base para archivos locales (solo si STORAGE_PROVIDER=local)
API_URL=http://localhost:8181
# Credenciales del bucket de imágenes en Supabase
# (Project Settings -> API -> Project URL / API keys)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-o-service-role-key
# Nombre del bucket donde se guardan las imágenes
# (se crea en Supabase Dashboard -> Storage)
SUPABASE_BUCKET=uploads

# ============================================
# PayPal
# ============================================
# Si se omiten PAYPAL_CLIENT y PAYPAL_SECRET,
# el sistema usa mocks automáticamente (nock)
# PAYPAL_CLIENT=tu-client-id
# PAYPAL_SECRET=tu-secret
# PAYPAL_URI=https://api-m.sandbox.paypal.com
# PRODUCT_TYPE=SERVICE
# PRODUCT_CATEGORY=SERVICES