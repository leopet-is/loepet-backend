# ============================================
# Servidor
# ============================================
PORT=8181
NODE_ENV=development

# ============================================
# Base de datos MySQL
# ============================================
MYSQL_DATABASE=integradoradb
MYSQL_USER=usuario
MYSQL_ROOT_PASSWORD=contraseña
MYSQL_HOSTNAME=localhost
MYSQL_ROOT_PORT=3306
# Alternativos (solo si se usan en DB/index.js directamente)
# MYSQL_HOST=localhost
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=root

# ============================================
# JWT
# ============================================
# JWT_SECRET=mi-secreto-seguro

# ============================================
# Almacenamiento (Local vs S3/DigitalOcean)
# ============================================
USE_LOCAL_STORAGE=true
# URL base para archivos locales (solo si USE_LOCAL_STORAGE=true)
API_URL=http://localhost:8181
# Credenciales DigitalOcean Spaces / S3 (solo si USE_LOCAL_STORAGE=false)
# S3_BUCKET=nombre-del-bucket
# DIGITAL_ENDPOINT=nyc3.digitaloceanspaces.com
# DIGITAL_ACCESS_KEY_ID=tu-access-key
# DIGITAL_SECRET_ACCESS_KEY=tu-secret-key
# DIGITAL_BUCKET=nombre-del-bucket

# ============================================
# PayPal
# ============================================
# Si se omiten PAYPAL_CLIENT y PAYPAL_SECRET,
# el sistema usa mocks automáticamente (nock)
# PAYPAL_CLIENT=tu-client-id
# PAYPAL_SECRET=tu-secret
# PAYPAL_URI=https://api-m.sandbox.paypal.com
# PRODUCT_TYPE=SERVICE
# PRODUCT_CATEGORY=SERVICES