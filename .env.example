# ============================================
# Servidor
# ============================================
PORT=8181
NODE_ENV=development

# ============================================
# BASE DE DATOS — Desarrollo local (Postgres en Docker)
# ============================================
# Levantar con: docker compose up -d postgres
DATABASE_URL=postgresql://leopet:leopet@localhost:5432/leopet_dev
# true solo en produccion/Supabase; false en dev (Postgres local no usa TLS)
DB_SSL=false

# ============================================
# BASE DE DATOS — Produccion (Supabase)
# ============================================
# Usa esto EN PRODUCCION (Render): Project Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres:postgres@db.example.supabase.co:5432/postgres
# DB_SSL=true

# ============================================
# JWT
# ============================================
# JWT_SECRET=mi-secreto-seguro

# ============================================
# Almacenamiento de imagenes (Supabase Storage / Local)
# ============================================
# 'supabase' (produccion) o 'local' (desarrollo con STORAGE_PROVIDER=local)
STORAGE_PROVIDER=local
# URL base para archivos locales (solo si STORAGE_PROVIDER=local)
API_URL=http://localhost:8181
# Credenciales del bucket de imagenes en Supabase (usar en produccion)
# (Project Settings -> API -> Project URL / API keys)
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_KEY=tu-anon-o-service-role-key
# Nombre del bucket donde se guardan las imagenes
# (se crea en Supabase Dashboard -> Storage)
# SUPABASE_BUCKET=uploads

# ============================================
# CORREO — Resend (https://resend.com)
# ============================================
# Sin RESEND_API_KEY el servicio usa el modo 'console':
# no envia nada, solo imprime el correo en los logs (desarrollo).
# Crear una API key en https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx
# El remitente debe usar un dominio verificado en Resend
# RESEND_FROM=LEOPET <no-reply@tudominio.com>
# Destinatario por defecto de la prueba (npm run email:test)
# MAIL_TO=dev@test.com

# ============================================
# PayPal
# ============================================
# Si se omiten PAYPAL_CLIENT y PAYPAL_SECRET,
# el sistema usa mocks automaticamente (nock)
# PAYPAL_CLIENT=tu-client-id
# PAYPAL_SECRET=tu-secret
# PAYPAL_URI=https://api-m.sandbox.paypal.com
# PRODUCT_TYPE=SERVICE
# PRODUCT_CATEGORY=SERVICES