{
  "name": "backend",
  "version": "0.0.1",
  "description": "backend_proyecto_materia_integradora",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "cross-env NODE_ENV=test JWT_SECRET=secret STORAGE_PROVIDER=local jest --coverage",
    "test:watch": "cross-env NODE_ENV=test JWT_SECRET=secret STORAGE_PROVIDER=local jest --watch",
    "test:unit": "cross-env NODE_ENV=test JWT_SECRET=secret STORAGE_PROVIDER=local jest test/db test/lib test/middleware --passWithNoTests",
    "start": "cross-env NODE_ENV=development nodemon server.js",
    "start:test": "cross-env NODE_ENV=test nodemon server.js",
    "lint": "eslint . --ext .js --ignore-path .gitignore",
    "db:migrate": "sequelize-cli db:migrate",
    "db:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "db:undo:test": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo",
    "email:test": "node scripts/test-email.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Integradora2021/Back.git"
  },
  "author": "IlianaB_OmarR",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Integradora2021/Back/issues"
  },
  "homepage": "https://github.com/Integradora2021/Back#readme",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.17",
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^0.21.4",
    "axios-mock-adapter": "^2.1.0",
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "dayjs": "^1.10.6",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "express-validator": "^6.12.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "multer": "^1.4.4",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "request": "^2.88.2",
    "resend": "^6.25.0",
    "sequelize": "^6.33.0",
    "sequelize-auto": "^0.8.8",
    "swagger-jsdoc": "^6.3.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.6",
    "cross-env": "^10.1.0",
    "eslint": "^8.18.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.0",
    "eslint-plugin-security": "^2.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "nock": "^14.0.10",
    "nodemon": "^2.0.19",
    "prettier": "^2.8.0",
    "sequelize-cli": "^6.6.5",
